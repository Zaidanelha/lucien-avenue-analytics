# Salin file ini menjadi .env lalu sesuaikan. Tanpa .env, proyek memakai SQLite di folder data/.

# --- Koneksi database (opsional) ---
# Contoh MySQL/MariaDB (XAMPP): buat dulu database lucien_source & lucien_dw
# SOURCE_DB_URL=mysql+pymysql://root:@localhost:3306/lucien_source
# WAREHOUSE_DB_URL=mysql+pymysql://root:@localhost:3306/lucien_dw

# --- Parameter data sintetis ---
START_DATE=2024-01-01
END_DATE=2025-12-31
N_CUSTOMERS=10000
BASE_DAILY_ORDERS=35
RANDOM_SEED=42
